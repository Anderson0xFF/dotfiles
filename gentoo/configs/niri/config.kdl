input {
    keyboard {
        xkb {
            layout "us,br"
            options "grp:alt_shift_toggle"
        }
    }
}

cursor {
    xcursor-theme "Adwaita"
    xcursor-size 8
}

blur {
    passes 4
    offset 4.0
    noise 0.015
    saturation 1.3
}

prefer-no-csd

environment {
    LC_TIME "pt_BR.UTF-8"
    GTK_USE_PORTAL "1"
    MOZ_ENABLE_WAYLAND "1"
    QT_QPA_PLATFORM "wayland;xcb"
    QT_QPA_PLATFORMTHEME "qt6ct"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
}


spawn-at-startup "gentoo-pipewire-launcher"
spawn-at-startup "udiskie" "--tray"
spawn-at-startup "sh" "-c" "dbus-update-activation-environment --all"

/*spawn-at-startup "waybar"
spawn-at-startup "sh" "-c" "waypaper --restore"
spawn-at-startup "swayosd-server"
spawn-at-startup "mako"
spawn-at-startup "swayidle" "-w"

spawn-at-startup "sh" "-c" "gsettings set org.gnome.desktop.interface color-scheme prefer-dark; gsettings set org.gnome.desktop.interface gtk-theme Adwaita-dark"
*/

spawn-at-startup "noctalia"


layout {
    gaps 4
    struts {
        left 18
        right 18
        bottom 8
    }

    center-focused-column "never"
    always-center-single-column false

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    // border {
    //     off
    // }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#00000077"
    }

    focus-ring {
        width 2
        active-gradient from="red" to="orange" angle=45 in="oklch longer hue" relative-to="workspace-view"
        inactive-color "#333333"
    }
}

window-rule {
    geometry-corner-radius 2
    clip-to-geometry true
    draw-border-with-background false
}

window-rule {
    // Qualquer janela do Thunar (app-id real é "Thunar", via XWayland)...
    match app-id=r#"(?i)^thunar$"#

    // ...EXCETO a janela principal (que termina com " - Thunar")
    exclude title=r#" - Thunar$"#

    open-floating true
    max-width 800
    max-height 600
}


window-rule {
    match app-id="^xdg-desktop-portal"
    open-floating true
    max-width 1200
    max-height 800
}

window-rule {
    match app-id="^firefox-bin$" title="^Picture-in-Picture$"
    open-floating true
    max-width 700
    max-height 400
}

window-rule {
    match app-id="^firefox(-bin)?$" title="^Enter name of file to save to"
    match app-id="^firefox(-bin)?$" title="^Salvar como$"
    match app-id="^firefox(-bin)?$" title="^File Upload$"
    match app-id="^firefox(-bin)?$" title="^Enviar arquivo$"
    match app-id="^firefox(-bin)?$" title="^Authentication Required$"
    match app-id="^firefox(-bin)?$" title="^Autenticação necessária$"
    open-floating true
    max-width 960
    max-height 720
}

window-rule {
    match app-id="^polkit-gnome-authentication-agent-1$"
    match app-id="polkit"
    open-floating true
    max-width 600
    max-height 400
}

/* nmtui: substituido pelo painel Network do noctalia (clique no widget de rede)
window-rule {
    match app-id=r"^com\.mitchellh\.ghostty$" title="^nmtui$"
    open-floating true
    default-column-width {}
    default-window-height {}
    max-width 1020
    max-height 720
}
*/

/* wiremix: substituido pelo painel Audio do noctalia (clique no widget de volume)
window-rule {
    match app-id=r"^com\.mitchellh\.ghostty$" title="^wiremix$"
    open-floating true
    default-column-width {}
    default-window-height {}
    max-width 1020
    max-height 720
}
*/

/* waypaper: substituido pelo painel Wallpaper do noctalia
window-rule {
    match app-id="^waypaper$"
    open-floating true
    max-width 900
    max-height 600
}
*/

/* walker: substituido pelo launcher do noctalia
layer-rule {
    match namespace="^walker$"

    background-effect {
        blur true
        xray false
    }
}
*/

/* fuzzel: era o power-menu do waybar; substituido pelo painel Session do noctalia
layer-rule {
    match namespace="^fuzzel$"

    background-effect {
        blur true
        xray false
    }
}
*/

// A barra do noctalia pede blur via ext-background-effect no retangulo inteiro
// dela, mesmo com background_opacity 0 — apareceria uma faixa borrada ligando
// as ilhas. blur false = nunca borrar, sobrepoe o pedido do cliente.
layer-rule {
    match namespace="^noctalia-bar"
    background-effect {
        blur false
    }
}

window-rule {
    match app-id="^code$"
    background-effect {
        blur true
        xray false
    }
}

window-rule {
    match app-id=r"^com\.mitchellh\.ghostty$"

    draw-border-with-background false

    background-effect {
        blur true
        xray false
    }
}

binds {
    Mod+Return       { spawn "ghostty"; }
    //Mod+D            { spawn "walker"; }   // externo: substituido pelo launcher do noctalia
    Mod+D            { spawn "noctalia" "msg" "panel-toggle" "launcher"; }

    Mod+Shift+Slash  { show-hotkey-overlay; }
    Mod+Shift+E      { quit; }
    Mod+Shift+P      { power-off-monitors; }

    Mod+Q            { close-window; }
    Mod+F            { maximize-column; }
    Mod+Shift+F      { fullscreen-window; }

    Mod+Left         { focus-column-left; }
    Mod+Right        { focus-column-right; }
    Mod+Up           { focus-window-up; }
    Mod+Down         { focus-window-down; }

    //Mod+L            { spawn "sh" "-c" "pidof -x swaylock || swaylock"; }   // externo: lockscreen do noctalia
    Mod+L            { spawn "noctalia" "msg" "session" "lock"; }
    Mod+Shift+Left   { move-column-left; }
    Mod+Shift+Right  { move-column-right; }
    Mod+Shift+Up     { move-window-up; }
    Mod+Shift+Down   { move-window-down; }

    Mod+Page_Down       { focus-workspace-down; }
    Mod+Page_Up         { focus-workspace-up; }
    Mod+U               { focus-workspace-down; }
    Mod+I               { focus-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+Shift+Page_Up   { move-column-to-workspace-up; }
    Mod+Shift+U         { move-column-to-workspace-down; }
    Mod+Shift+I         { move-column-to-workspace-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+R            { switch-preset-column-width; }
    Mod+Shift+R      { reset-window-height; }
    Mod+Minus        { set-column-width "-10%"; }
    Mod+Equal        { set-column-width "+10%"; }
    Mod+Shift+Minus  { set-window-height "-10%"; }
    Mod+Shift+Equal  { set-window-height "+10%"; }

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    Mod+V            { toggle-window-floating; }
    Mod+Shift+V      { switch-focus-between-floating-and-tiling; }

    Mod+Shift+Space  { switch-layout "next"; }

    // externos (grim/slurp/wl-copy): substituidos pelo screenshot do noctalia
    //Print            { spawn "sh" "-c" "grim -g \"$(slurp)\" - | wl-copy"; }
    //Shift+Print      { spawn "sh" "-c" "grim - | wl-copy"; }
    //Mod+Print        { spawn "sh" "-c" "grim -g \"$(slurp)\" ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png"; }
    //Mod+Shift+Print  { spawn "sh" "-c" "grim ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png"; }
    Print            { spawn "noctalia" "msg" "screenshot-region"; }
    Shift+Print      { spawn "noctalia" "msg" "screenshot-fullscreen"; }

    Mod+Tab          { toggle-overview; }

    // externos (playerctl, music-osd, swayosd-client, brightness-osd):
    // o noctalia ja traz media, volume, mic e brilho com OSD proprio ([osd] no config.toml)
    //XF86AudioPlay         allow-when-locked=true { spawn "playerctl" "play-pause"; }
    //XF86AudioNext         allow-when-locked=true { spawn "music-osd" "next"; }
    //XF86AudioPrev         allow-when-locked=true { spawn "music-osd" "previous"; }
    //XF86AudioRaiseVolume  allow-when-locked=true { spawn "swayosd-client" "--output-volume" "raise" "--max-volume" "150"; }
    //XF86AudioLowerVolume  allow-when-locked=true { spawn "swayosd-client" "--output-volume" "lower"; }
    //XF86AudioMute         allow-when-locked=true { spawn "swayosd-client" "--output-volume" "mute-toggle"; }
    //XF86AudioMicMute      allow-when-locked=true { spawn "swayosd-client" "--input-volume" "mute-toggle"; }
    //XF86MonBrightnessUp   allow-when-locked=true { spawn "brightness-osd" "up"; }
    //XF86MonBrightnessDown allow-when-locked=true { spawn "brightness-osd" "down"; }
    //Mod+F6 { spawn "brightness-osd" "up"; }
    //Mod+F5 { spawn "brightness-osd" "down"; }
    XF86AudioPlay         allow-when-locked=true { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioPause        allow-when-locked=true { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioStop         allow-when-locked=true { spawn "noctalia" "msg" "media" "stop"; }
    XF86AudioNext         allow-when-locked=true { spawn "noctalia" "msg" "media" "next"; }
    XF86AudioPrev         allow-when-locked=true { spawn "noctalia" "msg" "media" "previous"; }
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute         allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "noctalia" "msg" "mic-mute"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }
    Mod+F6 { spawn "noctalia" "msg" "brightness-up"; }
    Mod+F5 { spawn "noctalia" "msg" "brightness-down"; }
}

gestures {
    hot-corners {}
}


output "DP-1" {
    scale 1.0
    mode "3840x2160@240.084"
}

/*
output "HDMI-A-1" {
    scale 1.0
    mode "3840x2160@120.000"
}
*/

include "noctalia.kdl"
